{
  "name": "vat-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "세무사용 부가세 신고 준비 워크벤치 — 파일 업로드, 규칙 + 로컬 LLM Agent 제안, 사람 승인, 신고서 요약",
  "license": "MIT",
  "scripts": {
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "llm:start": "bash scripts/llm.sh",
    "samples": "tsx scripts/make-samples.ts && tsx scripts/make-pdf-sample.ts",
    "demo:reset": "tsc -p tsconfig.json --outDir .tmp-reset && node .tmp-reset/scripts/reset-demo.js; rm -rf .tmp-reset",
    "build": "tsc -p tsconfig.build.json && npm --prefix web run build",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@mikro-orm/core": "^6.3.13",
    "@mikro-orm/nestjs": "^6.0.2",
    "@mikro-orm/postgresql": "^6.3.13",
    "@nestjs/common": "^10.4.6",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-fastify": "^10.4.6",
    "exceljs": "^4.4.0",
    "graphql": "^16.9.0",
    "mercurius": "^14.1.0",
    "pdfjs-dist": "6.4.299",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc/core": "^1.7.40",
    "@types/node": "^22.8.1",
    "@types/pdfkit": "0.17.7",
    "pdfkit": "0.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.4"
  }
}
